# Server (Railway)
PORT=3001
NODE_ENV=development
# Prefer Supabase "Session pooler" URI (IPv4). Direct db.*.supabase.co is often IPv6-only
# and unreachable from Railway — create/join then fails with "Service temporarily unavailable".
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
ADMIN_API_TOKEN=dev-admin-token-change-me

# Web (Vercel / Vite)
VITE_SOCKET_URL=http://localhost:3001
